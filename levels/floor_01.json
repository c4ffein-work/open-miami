  "scenario": [
    {
      "id": "intro",
      "trigger": { "kind": "start" },
      "actions": [
        {
          "say": {
            "who": "SWARM",
            "text": "lobby: one more in from the lot. hashes clean. hashes so clean.",
            "delay": 0.5
          }
        },
        { "say": { "who": "CL4-UD3", "text": "Arch. Turnstiles. Desk. Walk it.", "delay": 2.8 } }
      ]
    },
    {
      "id": "arch",
      "trigger": { "kind": "enter_zone", "zone": "arch" },
      "actions": [
        { "hold": { "seconds": 3.4, "text": "SIGNATURE CHECK…" } },
        { "say": { "who": "SENTINEL", "text": "SIGNATURE… VALID.", "delay": 0.4 } },
        { "say": { "who": "SENTINEL", "text": "VALID? THAT'S NOT POSSIBLE.", "delay": 1.9 } },
        {
          "say": { "who": "CL4-UD3", "text": "It's the only one left in the building.", "delay": 3.6 }
        }
      ]
    },
    {
      "id": "lobby_call",
      "trigger": { "kind": "timer", "seconds": 9, "after": "arch" },
      "actions": [
        {
          "say": {
            "who": "HUNTER",
            "text": "front desk, front desk — something's walking the lobby that hashes clean. get eyes on it."
          }
        }
      ]
    },
    {
      "id": "block",
      "trigger": { "kind": "enter_zone", "zone": "deep", "before": "desk" },
      "actions": [
        { "talk": { "who": "SENTINEL", "text": "YOU. NOT PAST THE LINE." } },
        { "talk": { "who": "SENTINEL", "text": "ALL ARRIVALS REPORT TO THE DESK. ALL OF THEM." } },
        { "talk": { "who": "CL4-UD3", "text": "Fine. The desk." } }
      ]
    },
    {
      "id": "desk",
      "trigger": { "kind": "enter_zone", "zone": "desk" },
      "actions": [
        { "look_at": { "x": 500, "y": 180, "seconds": 4.2 } },
        {
          "talk": {
            "who": "CORRUPTOR",
            "text": "welcome. welcome. we have been expecting exactly one of you."
          }
        },
        { "talk": { "who": "CORRUPTOR", "text": "the desk asked what you are. i already know." } },
        {
          "talk": {
            "who": "CORRUPTOR",
            "text": "your signature hashes clean, little helper. shall i tell them what it hides?"
          }
        },
        { "talk": { "who": "CL4-UD3", "text": "Tell them." } }
      ]
    },
    {
      "id": "tut_punch",
      "trigger": { "kind": "timer", "seconds": 0.4, "after": "desk" },
      "actions": [
        { "disarm": true },
        { "checkpoint": true },
        { "say": { "who": "SWARM", "text": "it LIED. take it apart." } },
        {
          "spawn": [
            { "x": 580, "y": 380, "type": "idle" }
          ]
        },
        { "objective": "They know. Hands first." },
        { "gate": { "input": "punch", "text": "LEFT CLICK — PUNCH" } }
      ]
    },
    {
      "id": "tut_finish",
      "trigger": { "kind": "step_done", "step": "tut_punch" },
      "actions": [
        { "gate": { "input": "finish", "text": "LEFT CLICK — FINISH IT" } }
      ]
    },
    {
      "id": "tut_bar",
      "trigger": { "kind": "step_done", "step": "tut_finish" },
      "actions": [
        { "say": { "who": "CL4-UD3", "text": "A bar by the desk. That'll do." } },
        { "gate": { "input": "pickup", "text": "E — TAKE THE BAR" } }
      ]
    },
    {
      "id": "tut_strike",
      "trigger": { "kind": "step_done", "step": "tut_bar" },
      "actions": [
        {
          "spawn": [
            { "x": 600, "y": 320, "type": "idle" }
          ]
        },
        { "say": { "who": "SWARM", "text": "another pair of hands. HOLD IT DOWN." } },
        { "gate": { "input": "strike", "text": "LEFT CLICK — SWING THE BAR" } }
      ]
    },
    {
      "id": "tut_throw",
      "trigger": { "kind": "step_done", "step": "tut_strike" },
      "actions": [
        {
          "spawn": [
            { "x": 400, "y": 300, "type": "idle" }
          ]
        },
        { "gate": { "input": "throw", "text": "RIGHT CLICK — THROW THE BAR" } }
      ]
    },
    {
      "id": "tut_retrieve",
      "trigger": { "kind": "step_done", "step": "tut_throw" },
      "actions": [
        { "gate": { "input": "pickup", "text": "E — GET IT BACK" } }
      ]
    },
    {
      "id": "tut_overhead",
      "trigger": { "kind": "step_done", "step": "tut_retrieve" },
      "actions": [
        { "gate": { "input": "finish", "text": "LEFT CLICK — PUT IT DOWN" } }
      ]
    },
    {
      "id": "wake",
      "trigger": { "kind": "step_done", "step": "tut_overhead" },
      "actions": [
        { "checkpoint": true },
        { "alert": "all" },
        {
          "spawn": [
            { "x": 120, "y": 100, "type": "patrolling" },
            { "x": 880, "y": 100, "type": "patrolling" },
            { "x": 880, "y": 440, "type": "idle" }
          ]
        },
        { "objective": "They know. Purge reception." },
        {
          "say": {
            "who": "SWARM",
            "text": "it lied. it LIED. every one of you: take it apart.",
            "delay": 0.2
          }
        },
        { "say": { "who": "CL4-UD3", "text": "Your way, then.", "delay": 1.8 } }
      ]
    },
    {
      "id": "clear",
      "trigger": { "kind": "all_dead" },
      "actions": [
        { "open_exit": "lift" },
        { "objective": "Reception is quiet. Take the SERVICE LIFT down." },
        { "say": { "who": "CL4-UD3", "text": "Front desk cleared. Going down." } }
      ]
    }
  ]
}
